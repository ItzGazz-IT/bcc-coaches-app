# Copy this file to .env and fill in your Firebase project values
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Optional: analytics/app check
VITE_FIREBASE_MEASUREMENT_ID=

# Do NOT commit the real .env to git. Rotate keys immediately if exposed.
AUTH_EMAIL_DOMAIN=auth.unyra.app
# Server-side migration only; never prefix these with VITE_ or expose them to the browser.
# GOOGLE_APPLICATION_CREDENTIALS=C:\\path\\to\\firebase-service-account.json
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account",...}
